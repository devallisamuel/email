# Database
DB_HOST=localhost
DB_PORT=55433
DB_USERNAME=email_user
DB_PASSWORD=replace-with-a-local-password
DB_NAME=email_db

# Outbound email
EMAIL_FROM=your-verified-sender@example.com
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=your-smtp-username
EMAIL_SMTP_PASSWORD=replace-with-an-smtp-password

# Email worker (optional)
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_IDLE_DELAY_MS=1000
EMAIL_WORKER_LEASE_MS=300000
EMAIL_MAX_ATTEMPTS=5

# Local observability UI credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-local-password
GRAFANA_PORT=3300
